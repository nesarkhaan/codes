@using FileShare.Web.Services
@inject IFileShareUiService FileShareService
@{
    var configuration = FileShareService.GetConfiguration();
    var connectedPeers = FileShareService.GetPeers().Count(peer => peer.IsConnected);
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var packagesNavClass = currentPage.Equals("/Packages", StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
    var peersNavClass = currentPage.Equals("/Peers", StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
    var configurationNavClass = currentPage.Equals("/Configuration", StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
    var helpNavClass = currentPage.Equals("/Help", StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>@ViewData["Title"] - FileShare</title>
    <link rel="stylesheet" href="~/css/fileshare-ui.css" asp-append-version="true">
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Packages" aria-label="FileShare packages">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <circle cx="6" cy="12" r="2.5"></circle>
                    <circle cx="18" cy="6" r="2.5"></circle>
                    <circle cx="18" cy="18" r="2.5"></circle>
                    <path d="m8.3 10.8 7.3-3.7M8.3 13.2l7.3 3.7"></path>
                </svg>
            </span>
            <span>FileShare</span>
        </a>

        <div class="top-actions">
            <button class="button button-dark" type="button" data-dialog-open="add-package-dialog">
                <span aria-hidden="true">+</span> Add package
            </button>
            <button class="button button-primary" type="button" data-dialog-open="connect-peer-dialog">
                Connect peer
            </button>
            <button class="mobile-menu-button" type="button" data-menu-toggle aria-label="Toggle navigation" aria-expanded="false">☰</button>
        </div>
    </header>

    <div class="statusbar" aria-label="Current FileShare status">
        <span><span class="status-dot" aria-hidden="true"></span> Listening</span>
        <span>Port @configuration.Port</span>
        <span>@configuration.Nickname</span>
        <span>@connectedPeers @(connectedPeers == 1 ? "peer" : "peers") connected</span>
    </div>

    <div class="app-grid">
        <aside class="sidebar" data-sidebar>
            <nav aria-label="FileShare sections">
                <a class="@packagesNavClass" asp-page="/Packages">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v12H4zM8 4h8l2 3H6z"></path></svg>
                    <span>Packages</span>
                </a>
                <a class="@peersNavClass" asp-page="/Peers">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="9" r="3"></circle><circle cx="17" cy="8" r="2.5"></circle><path d="M3 19c.5-3.1 2.2-4.8 5-4.8s4.5 1.7 5 4.8M14 13.3c3.7-.5 6 1.4 6.5 4.7"></path></svg>
                    <span>Peers</span>
                </a>
                <a class="@configurationNavClass" asp-page="/Configuration">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M12 3v3m0 12v3m9-9h-3M6 12H3m15.4-6.4-2.1 2.1M7.7 16.3l-2.1 2.1m12.8 0-2.1-2.1M7.7 7.7 5.6 5.6"></path></svg>
                    <span>Configuration</span>
                </a>
                <a class="@helpNavClass" asp-page="/Help">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M9.8 9a2.3 2.3 0 1 1 3.4 2c-.8.4-1.2 1-1.2 2v.2M12 17h.01"></path></svg>
                    <span>Help</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <span class="status-dot" aria-hidden="true"></span>
                <div>
                    <strong>Service running</strong>
                    <small>Ready for connections</small>
                </div>
            </div>
        </aside>

        <main class="content" id="main-content">
            <partial name="_StatusMessage" />
            @RenderBody()
        </main>
    </div>

    <dialog class="dialog dialog-small" id="add-package-dialog" aria-labelledby="add-package-title">
        <form method="post" enctype="multipart/form-data" asp-page="/Packages" asp-page-handler="Add">
            <div class="dialog-heading">
                <div>
                    <p class="eyebrow">New managed package</p>
                    <h2 id="add-package-title">Add package</h2>
                </div>
                <button class="icon-button" type="button" data-dialog-close aria-label="Close add package form">×</button>
            </div>
            <div class="field">
                <label for="package-file">Package file</label>
                <input id="package-file" name="PackageFile" type="file" accept=".tpk">
                <small>Select a readable, valid <code>.tpk</code> descriptor.</small>
            </div>
            <div class="dialog-actions">
                <button class="button" type="button" data-dialog-close>Cancel</button>
                <button class="button button-primary" type="submit">Add package</button>
            </div>
        </form>
    </dialog>

    <dialog class="dialog dialog-small" id="connect-peer-dialog" aria-labelledby="connect-peer-title">
        <form method="post" asp-page="/Peers" asp-page-handler="Connect">
            <div class="dialog-heading">
                <div>
                    <p class="eyebrow">New network connection</p>
                    <h2 id="connect-peer-title">Connect to peer</h2>
                </div>
                <button class="icon-button" type="button" data-dialog-close aria-label="Close connect peer form">×</button>
            </div>
            <div class="form-grid form-grid-compact">
                <div class="field field-wide">
                    <label for="peer-ip-address">IP address</label>
                    <input id="peer-ip-address" name="IpAddress" type="text" inputmode="decimal" placeholder="192.168.1.20" autocomplete="off">
                </div>
                <div class="field">
                    <label for="peer-port">Port</label>
                    <input id="peer-port" name="Port" type="number" min="1" max="65535" placeholder="9000">
                </div>
            </div>
            <div class="dialog-actions">
                <button class="button" type="button" data-dialog-close>Cancel</button>
                <button class="button button-primary" type="submit">Connect</button>
            </div>
        </form>
    </dialog>

    <script src="~/js/fileshare-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
